# LoRa PLB Gateway Configuration
# Copy this file to .env and update values for your environment

# Application Settings
APP_NAME="LoRa PLB Gateway"
APP_VERSION="1.0.0"
DEBUG=False
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# PostgreSQL connection string in the format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/plb_gateway"

# Gateway Identity
GATEWAY_ID="GATEWAY_01"

# LoRa Radio Parameters (SX1278 Module)
LORA_FREQUENCY=433.0
LORA_BANDWIDTH=125000
LORA_CODING_RATE=5
LORA_SPREADING_FACTOR=7
LORA_TX_POWER=17
LORA_RX_TIMEOUT=10
LORA_ACK_TIMEOUT=5
LORA_RETRY_COUNT=3

# Hardware SPI / GPIO Settings (Raspberry Pi)
SPI_BUS=0
SPI_DEVICE=0
GPIO_RESET_PIN=25
GPIO_DIO0_PIN=24

# Timeout & Cache Settings
HEARTBEAT_TIMEOUT_SECONDS=900
DUPLICATE_CACHE_TTL_SECONDS=3600

# Queue Worker Settings
ACK_QUEUE_WORKERS=1
OUTBOUND_QUEUE_WORKERS=1

# Map & GIS Settings
# Get your MapTiler API key from https://cloud.maptiler.com/
MAPTILER_API_KEY=""
